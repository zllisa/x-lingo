# 复制此文件为 .env，填入你的真实 Key。不要把真实 Key 提交到 Git。

# Gemini AI — 口语对话、翻译和语法讲解
PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# DeepSeek AI — 备用模型提供商
PUBLIC_DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 通义千问 Qwen3.8 Flash — 中国大陆直连模型
PUBLIC_QWEN_API_KEY=your_qwen_api_key_here

# 豆包 — 火山引擎方舟，中国大陆直连模型
PUBLIC_DOUBAO_API_KEY=your_doubao_api_key_here

# AI 提供商：doubao、gemini、qwen、deepseek 或 groq
PUBLIC_AI_PROVIDER=qwen
# 可选备用提供商；留空表示不自动回退
PUBLIC_AI_FALLBACK_PROVIDER=

# Azure TTS — 韩语朗读
PUBLIC_AZURE_TTS_KEY=your_azure_tts_key_here
PUBLIC_AZURE_TTS_REGION=eastasia

# Groq Whisper — 仅用于本地开发兜底；生产识别使用 Supabase groq-stt
PUBLIC_GROQ_API_KEY=your_groq_api_key_here

# 保留供旧构建兼容；当前精听统一使用服务端 Groq Whisper
PUBLIC_STT_PROVIDER=groq

# 七牛云 — 视频存储与音频转码
PUBLIC_QINIU_ACCESS_KEY=your_qiniu_access_key_here
PUBLIC_QINIU_SECRET_KEY=your_qiniu_secret_key_here
PUBLIC_QINIU_BUCKET=your_qiniu_bucket_here
PUBLIC_QINIU_DOMAIN=your_qiniu_domain_here
PUBLIC_QINIU_ZONE=z0
